strict-peer-dependencies=false
auto-install-peers=true
# NativeWind's babel preset rewrites every JSX file to import
# react-native-css-interop/jsx-runtime. Under pnpm's strict layout that
# package isn't resolvable by Metro, so hoist it (NativeWind + pnpm fix).
public-hoist-pattern[]=*react-native-css-interop*
