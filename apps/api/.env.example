# Copy to .env.local in this directory (apps/api)

PORT=8787

# Real users are authenticated via Supabase JWT (Authorization: Bearer <session token>),
# verified against these project values — same public URL/anon key the mobile app ships.
SUPABASE_URL=https://bvwumzzuvubiacueftbz.supabase.co
SUPABASE_ANON_KEY=sb_publishable_if5RMKHlwHLzUu97PaAcbQ_Vgm-rb7u

# Shared dev/guest key. Scoped narrowly (see middleware/auth.ts): can only ever
# authenticate as DEV_USER_ID or the guest-mode synthetic id — never as an
# arbitrary client-supplied user id.
AURA_API_KEY=
DEV_USER_ID=user-1

TRIGGER_SECRET_KEY=

# RevenueCat webhook (Settings → Integrations → Webhooks in the RevenueCat
# dashboard). SUPABASE_SERVICE_ROLE_KEY is the *secret* service role key from
# Supabase project settings — NEVER the anon/publishable key, and never ship
# it to the mobile app. It's the only credential allowed to write
# users.subscription_status (see the subscription_status migration + RLS
# trigger); regular user sessions cannot write that column.
REVENUECAT_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (optional; used for both Gemini Flash routing + Claude Sonnet copilot)
OPENROUTER_API_KEY=
OPENROUTER_GEMINI_ROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_CLAUDE_COPILOT_MODEL=anthropic/claude-sonnet-4

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_ROUTER_MODEL=gemini-2.0-flash
# Vision model for photo OCR (/v1/ocr — "Snap a homework page"). Requires
# GOOGLE_GENERATIVE_AI_API_KEY above.
GEMINI_VISION_MODEL=gemini-2.0-flash
ENABLE_GEMINI_ROUTER=true

# Soft per-user daily copilot message cap (cost guardrail). 0 = unlimited.
# Entry-tier limit; raise/skip for `pro` once RevenueCat entitlements are wired.
COPILOT_DAILY_MESSAGE_CAP=40

# NOTE: AURA_API_KEY above must equal EXPO_PUBLIC_AURA_API_KEY in apps/mobile/.env,
# and the deployed URL of this server must be set as EXPO_PUBLIC_AURA_API_URL.
